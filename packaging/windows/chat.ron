// Портабельний конфіг Quiver. Усі шляхи всередині ВІДНОСНІ — працює з будь-якої папки.
// Секрети ТУТ НЕ зберігаються: вони в окремому файлі credentials.ron
// (скопіюй credentials.ron.example -> credentials.ron і впиши свої).
//
// Що змінити перед першим запуском:
//   1. channel  -> ім'я твого Twitch-каналу (маленькими літерами)
//   2. скопіювати credentials.ron.example у credentials.ron (для бейджів/емотів)
(
    server: (
        listen: "127.0.0.1:4783",
        widget_dist: Some("widget"),
    ),
    twitch: (
        channel: "CHANGE_ME",
        // Окремий файл із client_id / client_secret. Якщо його немає —
        // застосунок просто працює без API Twitch (без бейджів/емотів каналу).
        credentials_file: Some("credentials.ron"),
    ),
    theme: (
        font_size_px: 27,
        max_messages: 30,
        message_lifetime_secs: 60,
        // Стиль чату — у папці css\. Редагуй css\custom-widget.css, сервер
        // підхопить зміни наживо (перезапуск не потрібен).
        //
        // Є друга готова тема: css\likh_tar.css. Щоб увімкнути її, заміни
        // рядок нижче на  uri: "file://css/likh_tar.css"  і додай блок
        // role_css (див. ГАЙД.txt, розділ 6 «Стиль»).
        custom_css: Some(( uri: "file://css/custom-widget.css" )),
        role_css: None,
        overflow_mode: prune,

        // Вигляд банерів подій: нагороди за бали (redeem) і бітси (cheer).
        // Токени у {} підставляються; невідомий токен = помилка конфіга
        // (релоад відхилять). Absent = цей самий вбудований дефолт.
        //   redeem: {reward_icon} іконка нагороди, {points_icon} іконка балів
        //           каналу, {reward} назва, {user} хто,
        //           {input} текст вводу, {input_clause} = ": <input>"/"".
        //   cheer:  {bits_icon} бейдж бітсів, {bits} сума, {user} хто,
        //           {message} текст, {message_clause} = ": <msg>"/"".
        // event_name: показувати пігулку назви події для redeem/cheer.
        //
        // Щоб змінити мову/порядок — ЗАМІНИ рядок, не додавай другий
        // однойменний ключ (RON впаде на дублікаті). Напр. українською:
        //   redeem: "{user} {points_icon}рідімить {reward_icon} {reward}{input_clause}",
        //   cheer:  "{bits_icon} {user} заряджає {bits} бітсів{message_clause}",
        event_layout: (
            redeem: "{reward_icon} {user} redeemed {reward}{input_clause}",
            cheer: "{bits_icon} {user} cheered {bits} bits{message_clause}",
            event_name: true,
        ),
    ),
    emotes: (
        twitch: true,
        unicode: true,
        seventv: true,
        bttv: true,
        ffz: true,
    ),
    filters: (
        display_name: None,
        username: None,
        user_id: None,
        content: None,
        message_type: None,
        role: None,
    ),
    badges: None,
)
